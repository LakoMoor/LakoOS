; PROJECT:     LakoOS SpacemiT K1 Ethernet Driver
; LICENSE:     GPL-3.0-or-later (https://spdx.org/licenses/GPL-3.0-or-later)
; PURPOSE:     SpacemiT K1 EMAC miniport installation file
; COPYRIGHT:   Copyright 2026 Ahmed ARIF <arif.ing@outlook.com>

[Version]
Signature="$Windows NT$"
Class=Net
ClassGUID={4D36E972-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
CatalogFile=netk1xemac.cat
DriverVer=10/02/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir=12
K1XEMAC_CopyFiles.NT=12

[Manufacturer]
%ManufacturerName%=SpacemitMfg,NTRISCV64

[SpacemitMfg.NTRISCV64]
%K1XEMAC.DeviceDesc%=K1XEMAC_Inst.ndi,FDT\spacemit_k1x-emac

[K1XEMAC_Inst.ndi.NT]
Characteristics=0x4
BusType=0
*IfType=6
*MediaType=0
*PhysicalMediaType=14
AddReg=K1XEMAC_AddReg.NT
CopyFiles=K1XEMAC_CopyFiles.NT

[K1XEMAC_Inst.ndi.NT.Services]
AddService=k1xemac,0x00000002,K1XEMAC_Service_Inst

[K1XEMAC_AddReg.NT]
HKR,Ndi,Service,0,"k1xemac"
HKR,Ndi\Interfaces,UpperRange,0,"ndis5"
HKR,Ndi\Interfaces,LowerRange,0,"ethernet"

[K1XEMAC_CopyFiles.NT]
k1xemac.sys

[K1XEMAC_Service_Inst]
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\k1xemac.sys
LoadOrderGroup=NDIS

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
k1xemac.sys=1

[Strings]
ProviderName="Ahmed ARIF"
ManufacturerName="SpacemiT"
DiskName="SpacemiT K1 Ethernet Driver Disk"
K1XEMAC.DeviceDesc="SpacemiT K1 Ethernet Controller"
