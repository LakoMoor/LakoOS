[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGuid={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%LakoOS%
DriverVer=08/28/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir=12
K1xAudio.CopyFiles=12

[Manufacturer]
%LakoOS%=K1xAudioModels,NTRISCV64

[K1xAudioModels.NTRISCV64]
%K1xAudio.DeviceDesc%=K1xAudio_Install,FDT\spacemit_k1x-audio

[K1xAudio_Install]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=K1xAudio.CopyFiles
AddReg=K1xAudio.AddReg

[K1xAudio_Install.Services]
AddService=k1xaudio,0x00000002,K1xAudio_Service

[K1xAudio_Service]
DisplayName=%K1xAudio.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\k1xaudio.sys

[K1xAudio.CopyFiles]
k1xaudio.sys

[K1xAudio.AddReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,k1xaudio.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%K1xAudio.DeviceDesc%
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Description,,%K1xAudio.DeviceDesc%

[K1xAudio_Install.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,Wave,K1xAudio.WaveInterface
AddInterface=%KSCATEGORY_RENDER%,Wave,K1xAudio.WaveInterface
AddInterface=%KSCATEGORY_CAPTURE%,Wave,K1xAudio.WaveInterface
AddInterface=%KSCATEGORY_REALTIME%,Wave,K1xAudio.WaveInterface
AddInterface=%KSCATEGORY_AUDIO%,Topology,K1xAudio.TopologyInterface
AddInterface=%KSCATEGORY_TOPOLOGY%,Topology,K1xAudio.TopologyInterface

[K1xAudio.WaveInterface]
AddReg=K1xAudio.WaveInterface.AddReg

[K1xAudio.WaveInterface.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%K1xAudio.WaveName%

[K1xAudio.TopologyInterface]
AddReg=K1xAudio.TopologyInterface.AddReg

[K1xAudio.TopologyInterface.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%K1xAudio.TopologyName%

[SourceDisksNames]
1=%DiskName%

[SourceDisksFiles]
k1xaudio.sys=1

[Strings]
LakoOS="LakoOS"
K1xAudio.DeviceDesc="SpacemiT K1 Audio"
K1xAudio.ServiceDesc="LakoOS SpacemiT K1 Audio Driver"
K1xAudio.WaveName="SpacemiT K1 Audio Wave"
K1xAudio.TopologyName="SpacemiT K1 Audio Topology"
DiskName="LakoOS Installation Media"
Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY="{DDA54A40-1E4C-11D1-A050-405705C10000}"
