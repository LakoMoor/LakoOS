; PROJECT:     LakoOS PowerVR Rogue WDDM miniport
; LICENSE:     GPL-3.0-or-later (https://spdx.org/licenses/GPL-3.0-or-later)
; PURPOSE:     PowerVR Rogue graphics driver installation file
; COPYRIGHT:   Copyright 2026 Ahmed ARIF <arif.ing@outlook.com>

[Version]
Signature="$Windows NT$"
Class=Display
ClassGUID={4D36E968-E325-11CE-BFC1-08002BE10318}
Provider=%LakoOS%
DriverVer=10/04/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir=12

[Manufacturer]
%LakoOS%=LakoOS,NTriscv64

[LakoOS.NTriscv64]
%PowerVr.K1.DeviceDesc%=PowerVr_Install,FDT\spacemit_k1-gpu

[PowerVr_Install]
CopyFiles=PowerVr_CopyFiles
AddReg=PowerVr_SoftwareSettings

[PowerVr_CopyFiles]
powervr.sys

[PowerVr_SoftwareSettings]
HKR,,"Device Description",%REG_SZ%,"%PowerVr.K1.DeviceDesc%"
HKR,,"OpenGLDriverName",%REG_SZ%,"mesa_gallium.dll"
HKR,,"OpenGLVersion",%REG_DWORD%,1
HKR,,"OpenGLFlags",%REG_DWORD%,0

[PowerVr_Install.Services]
AddService=powervr,0x00000002,PowerVr_Service

[PowerVr_Service]
DisplayName=%PowerVr.ServiceDesc%
ServiceType=1
StartType=3
ErrorControl=0
ServiceBinary=%12%\powervr.sys
LoadOrderGroup=Video

[Strings]
LakoOS="LakoOS"
PowerVr.K1.DeviceDesc="SpacemiT K1 PowerVR BXE-2-32 GPU"
PowerVr.ServiceDesc="LakoOS PowerVR Rogue Graphics Driver"
REG_SZ=0x00000000
REG_DWORD=0x00010001
