; PROJECT:     LakoOS SpacemiT K1 watchdog driver
; LICENSE:     GPL-3.0-or-later (https://spdx.org/licenses/GPL-3.0-or-later)
; PURPOSE:     SpacemiT K1 watchdog driver installation file
; COPYRIGHT:   Copyright 2026 Ahmed ARIF <arif.ing@outlook.com>

[Version]
Signature="$Windows NT$"
Class=System
ClassGUID={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
CatalogFile=k1xwdt.cat
DriverVer=10/03/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir=12

[Manufacturer]
%ManufacturerName%=SpacemitMfg,NTRISCV64

[SpacemitMfg.NTRISCV64]
%K1XWDT.DeviceDesc%=K1XWDT_Inst,FDT\spacemit_k1x-wdt

[K1XWDT_Inst.NT]
CopyFiles=K1XWDT_CopyFiles.NT

[K1XWDT_CopyFiles.NT]
k1xwdt.sys

[K1XWDT_Inst.NT.Services]
AddService=k1xwdt,0x00000002,K1XWDT_Service_Inst

[K1XWDT_Service_Inst]
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\k1xwdt.sys

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
k1xwdt.sys=1

[Strings]
ProviderName="Ahmed ARIF"
ManufacturerName="SpacemiT"
DiskName="SpacemiT K1 Watchdog Driver Disk"
K1XWDT.DeviceDesc="SpacemiT K1 watchdog timer"
