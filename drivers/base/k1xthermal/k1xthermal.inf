; PROJECT:     LakoOS SpacemiT K1 thermal driver
; LICENSE:     GPL-3.0-or-later (https://spdx.org/licenses/GPL-3.0-or-later)
; PURPOSE:     SpacemiT K1 thermal driver installation file
; COPYRIGHT:   Copyright 2026 Ahmed ARIF <arif.ing@outlook.com>

[Version]
Signature="$Windows NT$"
Class=System
ClassGUID={4D36E97D-E325-11CE-BFC1-08002BE10318}
Provider=%ProviderName%
CatalogFile=k1xthermal.cat
DriverVer=10/03/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir=12

[Manufacturer]
%ManufacturerName%=SpacemitMfg,NTRISCV64

[SpacemitMfg.NTRISCV64]
%K1XTHERMAL.DeviceDesc%=K1XTHERMAL_Inst,FDT\spacemit_k1x-tsensor

[K1XTHERMAL_Inst.NT]
CopyFiles=K1XTHERMAL_CopyFiles.NT

[K1XTHERMAL_CopyFiles.NT]
k1xthermal.sys

[K1XTHERMAL_Inst.NT.Services]
AddService=k1xthermal,0x00000002,K1XTHERMAL_Service_Inst

[K1XTHERMAL_Service_Inst]
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\k1xthermal.sys

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
k1xthermal.sys=1

[Strings]
ProviderName="Ahmed ARIF"
ManufacturerName="SpacemiT"
DiskName="SpacemiT K1 Thermal Driver Disk"
K1XTHERMAL.DeviceDesc="SpacemiT K1 thermal zone"
