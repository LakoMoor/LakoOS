; PROJECT:     LakoOS SpacemiT K1 USB3 Glue Driver
; LICENSE:     GPL-3.0-or-later (https://spdx.org/licenses/GPL-3.0-or-later)
; PURPOSE:     SpacemiT K1 USB3 glue driver installation file
; COPYRIGHT:   Copyright 2026 Ahmed ARIF <arif.ing@outlook.com>

[Version]
Signature="$Windows NT$"
Class=USB
ClassGUID={36FC9E60-C465-11CF-8056-444553540000}
Provider=%ProviderName%
CatalogFile=usbk1xdwc3.cat
DriverVer=10/03/2026,1.0.0.0

[DestinationDirs]
DefaultDestDir=12

[Manufacturer]
%ManufacturerName%=SpacemitMfg,NTRISCV64

[SpacemitMfg.NTRISCV64]
%K1XDWC3.DeviceDesc%=K1XDWC3_Inst,FDT\spacemit_k1-x-dwc3

[K1XDWC3_Inst.NT]
CopyFiles=K1XDWC3_CopyFiles.NT

[K1XDWC3_CopyFiles.NT]
k1xdwc3.sys

[K1XDWC3_Inst.NT.Services]
AddService=k1xdwc3,0x00000002,K1XDWC3_Service_Inst

[K1XDWC3_Service_Inst]
ServiceType=1
StartType=0
ErrorControl=1
ServiceBinary=%12%\k1xdwc3.sys
LoadOrderGroup=Boot Bus Extender

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
k1xdwc3.sys=1

[Strings]
ProviderName="Ahmed ARIF"
ManufacturerName="SpacemiT"
DiskName="SpacemiT K1 USB3 Driver Disk"
K1XDWC3.DeviceDesc="SpacemiT K1 USB 3.0 controller"
