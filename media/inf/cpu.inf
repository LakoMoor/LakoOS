; Processor devices

[Version]
Signature  = "$Windows NT$"
Class      = Processor
ClassGuid  = {50127DC3-0F36-415E-A6CC-4CB3BE910B65}
Provider   = %LakoOS%
DriverVer  = 10/05/2026,1.0.0.0

[ControlFlags]
ExcludeFromSelect = *

[DestinationDirs]
DefaultDestDir = 12

[ClassInstall32.NT]
AddReg = ProcessorClass.NT.AddReg

[ProcessorClass.NT.AddReg]
HKR, , , 0, %ProcessorClassName%
HKR, , Icon, 0, "-28"
HKR, , NoInstallClass, 0, "1"

[Manufacturer]
%StdMfg% = StdMfg

[StdMfg]
%processor.DeviceDesc% = Processor_Inst, ACPI\VEN_ACPI&DEV_0007
%processor.DeviceDesc% = Processor_Inst, ACPI\ACPI0007
%processor.DeviceDesc% = Processor_Inst, ACPI\Processor

[Processor_Inst.NT]
CopyFiles = Processor_CopyFiles

[Processor_CopyFiles]
pnpcpu.sys

[Processor_Inst.NT.Services]
AddService = PNPCPU, 0x00000002, Pnpcpu_Service

[Pnpcpu_Service]
DisplayName    = %Pnpcpu.ServiceDesc%
ServiceType    = 1
StartType      = 3
ErrorControl   = 1
ServiceBinary  = %12%\pnpcpu.sys
LoadOrderGroup = Extended Base

[Strings]
LakoOS = "LakoOS Team"
ProcessorClassName = "Processors"
StdMfg = "(Standard processor types)"
processor.DeviceDesc = "Processor"
Pnpcpu.ServiceDesc = "Processor Driver"
