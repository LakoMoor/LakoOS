; Diagnostic Data service
[AddReg]
HKLM,"SYSTEM\CurrentControlSet\Services\DiagData","DisplayName",0x00000000,"Diagnostic Data"
HKLM,"SYSTEM\CurrentControlSet\Services\DiagData","Description",0x00000000,"Sends the diagnostic data to the LakoOS project: the system build, boot result and duration, the hardware model, device identifiers and crash summaries, and the optional data when it is turned on."
HKLM,"SYSTEM\CurrentControlSet\Services\DiagData","DependOnService",0x00010000,"PlugPlay"
HKLM,"SYSTEM\CurrentControlSet\Services\DiagData","ErrorControl",0x00010001,0x00000001
HKLM,"SYSTEM\CurrentControlSet\Services\DiagData","ImagePath",0x00020000,"%SystemRoot%\system32\diagdata.exe"
HKLM,"SYSTEM\CurrentControlSet\Services\DiagData","ObjectName",0x00000000,"LocalSystem"
HKLM,"SYSTEM\CurrentControlSet\Services\DiagData","Start",0x00010001,0x00000002
HKLM,"SYSTEM\CurrentControlSet\Services\DiagData","Type",0x00010001,0x00000010
